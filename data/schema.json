{
  "_comment": "Source of truth for combustion_runs.csv (docs/03_DATA_CONTRACT.md section 1). Loader, validator and the Run model are driven from this file (I-03).",
  "columns": [
    {"name": "run_id",           "type": "string", "nullable": false, "unique": true},
    {"name": "experiment",       "type": "string", "nullable": false,
      "soft_allowed": ["BASS", "BASS-II", "FLEX", "FLEX-2", "Saffire", "ACME", "Ground"]},
    {"name": "fuel_type",        "type": "string", "nullable": false, "allowed": ["solid", "droplet", "gas"]},
    {"name": "material",         "type": "string", "nullable": false},
    {"name": "gravity_g",        "type": "float",  "nullable": false, "min": 0.0,  "max": 1.0},
    {"name": "o2_percent",       "type": "float",  "nullable": false, "min": 15.0, "max": 40.0},
    {"name": "pressure_kpa",     "type": "float",  "nullable": false, "min": 50.0, "max": 101.3},
    {"name": "airflow_cm_s",     "type": "float",  "nullable": false, "min": 0.0,  "max": 50.0},
    {"name": "spread_rate_mm_s", "type": "float",  "nullable": true,  "min": 0.0, "model_target": "spread"},
    {"name": "flame_temp_k",     "type": "float",  "nullable": true,  "min": 300.0, "max": 3000.0, "model_target": "temp"},
    {"name": "extinguished",     "type": "bool",   "nullable": true,  "model_target": "extinction"},
    {"name": "burn_duration_s",  "type": "float",  "nullable": true,  "min": 0.0},
    {"name": "source_note",      "type": "string", "nullable": false}
  ]
}
