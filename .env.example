# Copy to .env (cp .env.example .env). Never commit .env.  (I-12)

# 1 = every prediction endpoint returns cheap deterministic stub values (frontend development).
# Real model arrives in Tier 2; then set this to 0 (or delete the line).
STUB_MODE=1

# LLM for insights / ask. Leave LLM_API_KEY empty to use template insights (app never breaks).
LLM_PROVIDER=openai          # openai | anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=                # optional, for OpenAI-compatible servers
LLM_TIMEOUT_S=8
