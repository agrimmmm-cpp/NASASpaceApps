# Copy to .env (cp .env.example .env). Never commit .env.  (I-12)

# 0 (default) = trained gradient-boosting model.
# 1 = every prediction endpoint returns cheap deterministic stub values (frontend development without the model).
STUB_MODE=0

# LLM for insights / ask. Leave LLM_API_KEY empty to use template insights (app never breaks).
LLM_PROVIDER=openai          # openai | anthropic
LLM_API_KEY=
LLM_MODEL=                   # empty = default (gpt-4o-mini / claude-haiku-5-5)
LLM_BASE_URL=                # optional, for OpenAI-compatible servers
LLM_TIMEOUT_S=8
